{
  "name": "opscale-co/nova-authorization",
  "description": "Secure your Nova resources with roles and permissions",
  "version": "1.2.1",
  "keywords": [
    "laravel",
    "nova",
    "package",
    "tool",
    "opscale",
    "authorization",
    "role",
    "permission"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "homepage": "https://github.com/opscale-co/nova-authorization",
  "license": "MIT",
  "authors": [
    {
      "name": "Opscale",
      "email": "development@opscale.co",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "opscale-co/actions": "^3.0",
    "opscale-co/nova-package-tools": "^1.1",
    "opscale-co/validations": "^1.0",
    "spatie/laravel-permission": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Opscale\\NovaAuthorization\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Opscale\\NovaAuthorization\\Tests\\": "tests",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Opscale\\NovaAuthorization\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.30"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "driftingly/rector-laravel": "^2.6",
    "larastan/larastan": "^3.10",
    "laravel/nova": "^5.10",
    "laravel/nova-devtool": "^1.10",
    "mockery/mockery": "^1.6",
    "opscale-co/strict-rules": "^1.3",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.6",
    "tightenco/duster": "^3.4"
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ]
  }
}
